# ============================================================
# PITH v5 — обязательные переменные окружения
# ============================================================
# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env
#   nano .env
# ============================================================

# --- OpenRouter API ключ (ОБЯЗАТЕЛЬНО) ---
# Без него роутер не сможет вызывать LLM.
# Получить: https://openrouter.ai/keys
OPENROUTER_KEY=

# --- Telegram Bot Token (для работы Telegram-интерфейса) ---
# Получить: https://t.me/BotFather → /newbot
TG_TOKEN=

# --- Telegram Owner/Admin Chat ID (для уведомлений оператору) ---
# Узнать: напиши боту @userinfobot, скопируй "Id"
OWNER_CHAT_ID=

# ============================================================
# Опциональные переменные (можно оставить пустыми)
# ============================================================

# PITH_ENV — окружение: dev / staging / production
PITH_ENV=dev

# Sentry (мониторинг ошибок) — DSN из https://sentry.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.1

# PostHog (аналитика использования)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Linear (интеграция с задачами)
LINEAR_API_KEY=
LINEAR_TEAM_ID=