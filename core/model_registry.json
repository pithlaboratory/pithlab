    "routing": {
    "global_policy": {
      "prefer_free_first": true,
      "prefer_deepseek_v4_flash_as_default_paid": true,
      "use_premium_only_for_high_stakes": true,
      "max_paid_hops_per_request": 2,
      "max_premium_hops_per_day": 8
    },

    "lanes": {
      "chat_fast": "llama33_70b",
      "chat_default": "deepseek_v4_flash",
      "chat_premium": "claude_sonnet_4",

      "code_free": "mimo_v2_flash",
      "code_paid": "kimi_k26",

      "reasoner_free": "deepseek_r1_free",
      "reasoner_paid": "deepseek_r1_paid"
    },

    "task_routes": {
      "simple_chat": ["llama33_70b", "deepseek_v4_flash"],
      "general_work": ["deepseek_v4_flash", "llama33_70b", "deepseek_v4_pro"],
      "simple_code": ["qwen3_coder_480b", "mimo_v2_flash", "deepseek_v4_flash"],
      "heavy_code": ["kimi_k26", "mimo_v2_flash", "deepseek_v4_pro"],
      "repo_wide_refactor": ["kimi_k26", "deepseek_v4_pro", "mimo_v2_flash"],
      "planning_reasoning": ["deepseek_r1_free", "deepseek_v4_pro", "deepseek_r1_paid"],
      "high_stakes_user_reply": ["deepseek_v4_flash", "claude_sonnet_4"],
      "final_validation": ["deepseek_r1_paid", "claude_sonnet_4"]
    },
    "escalation_rules": [
      {
        "if": "estimated_prompt_tokens > 120000",
        "route_to": "deepseek_v4_flash"
      },
      {
        "if": "repo_files_count > 40 OR changed_files_count > 12",
        "route_to": "kimi_k26"
      },
      {
        "if": "task_type == 'architecture' OR task_type == 'multi_step_planning'",
        "route_to": "deepseek_r1_free"
      },
      {
        "if": "confidence_score < 0.72 AND user_visible_output == true",
        "route_to": "deepseek_v4_pro"
      },
      {
        "if": "confidence_score < 0.62 AND answer_is_high_stakes == true",
        "route_to": "claude_sonnet_4"
      },
      {
        "if": "monthly_spend_usd > 22",
        "action": "disable_claude_sonnet_4_and_kimi_for_noncritical_tasks"
      },
      {
        "if": "monthly_spend_usd > 27",
        "action": "freeze_all_paid_except_deepseek_v4_flash_for_critical_requests"
      }
    ]
  },
  "observability": {
    "track": [
      "latency_ms",
      "prompt_tokens",
      "completion_tokens",
      "cache_hit_ratio",
      "cost_usd",
      "tool_calls_count",
      "fallback_count",
      "escalation_count",
      "self_rated_confidence"
    ],
    "alerts": {
      "cost_spike_daily_usd": 2.5,
      "kimi_overuse_calls_per_day": 20,
      "premium_overuse_calls_per_day": 8,
      "r1_latency_p95_ms": 35000
    }
  }
}